{
  "name": "swan",
  "version": "4.0.2",
  "description": "Bot discord de Skript-MC.",
  "main": "dist/src/main.js",
  "type": "module",
  "imports": {
    "#app/*": "./dist/src/*.js",
    "#config/*": "./dist/config/*.js",
    "#models/*": "./dist/src/models/*.js",
    "#moderation/*": "./dist/src/moderation/*.js",
    "#resolvers/*": "./dist/src/resolvers/*.js",
    "#structures/*": "./dist/src/structures/*.js",
    "#types/*": "./dist/src/types/*.js",
    "#utils/*": "./dist/src/utils/*.js"
  },
  "scripts": {
    "clean": "rimraf dist/",
    "build": "tsup",
    "watch": "tsup --watch",
    "start": "node --enable-source-maps ./dist/src/main.js",
    "dev": "tsup --watch --onSuccess \"npm start\"",
    "typecheck": "tsc -p tsconfig.json",
    "tools:update-databases": "node tools/update-databases.js",
    "tools:remove-commands": "node tools/remove-commands.js",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format . --write",
    "check": "biome check .",
    "check:fix": "biome check --write ."
  },
  "authors": [
    "noftaly (@noftaly)",
    "Romitou (@romitou)"
  ],
  "contributors": [
    "Olyno (@olyno)",
    "WeeskyBDW (@weeskybdw)",
    "Aless (@alessevan)",
    "Skylyxx (@skylyxx)",
    "iTrooz_ (@itrooz)"
  ],
  "license": "GPL-3.0-only",
  "engines": {
    "node": ">=22.18.0"
  },
  "homepage": "https://github.com/Skript-MC/Swan#readme",
  "bugs": {
    "url": "https://github.com/Skript-MC/Swan/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Skript-MC/Swan.git"
  },
  "dependencies": {
    "@octokit/rest": "^22.0.1",
    "@octokit/types": "^17.0.0",
    "@sapphire/decorators": "^6.2.0",
    "@sapphire/discord-utilities": "^4.0.0",
    "@sapphire/discord.js-utilities": "^7.3.3",
    "@sapphire/framework": "^5.5.1",
    "@sapphire/pieces": "^4.4.1",
    "@sapphire/plugin-logger": "^4.1.0",
    "@sapphire/utilities": "^3.18.3",
    "@sentry/node": "^11.8.0",
    "axios": "^1.20.0",
    "common-tags": "^1.8.2",
    "discord.js": "^14.27.0",
    "dotenv": "^18.0.8",
    "fastest-levenshtein": "^1.0.16",
    "he": "^2.0.0",
    "moment": "^2.31.0",
    "mongoose": "^9.11.2",
    "mongoose-autopopulate": "^1.2.1",
    "nanoid": "^6.0.2",
    "node-cron": "^4.6.0",
    "node-emoji": "^2.2.0",
    "pupa": "^3.3.0",
    "reflect-metadata": "^0.2.2",
    "semver": "^7.8.5",
    "turndown": "^7.2.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@sapphire/ts-config": "^5.0.3",
    "@types/common-tags": "^1.8.4",
    "@types/he": "^1.2.3",
    "@types/node": "^22.20.5",
    "@types/semver": "^7.8.0",
    "@types/turndown": "^5.0.6",
    "rimraf": "^6.1.3",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2"
  }
}
